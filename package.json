{"description":"Tempel tautan video TikTok, kirim likes gratis tanpa login. Situs statis + Cloudflare Pages Worker (tanpa dependensi produksi).","devDependencies":{"@playwright/test":"^1.55.0","puppeteer-core":"^23.11.1"},"engines":{"node":">=22"},"license":"MIT","name":"tiktok-likes-tool","private":true,"scripts":{"build":"node scripts/build.mjs","dev":"npm run build && npm run serve","make-video":"node scripts/make-video.mjs","screenshots":"node scripts/screenshot.mjs","serve":"node scripts/serve-worker.mjs","smoke":"node scripts/smoke.mjs","sweep":"python3 scripts/advisory-sweep.py","test":"node --test worker/_worker.test.mjs","validate":"node scripts/check-links.mjs && node scripts/check-static.mjs"},"type":"module","version":"1.1.0"}